import { Button, LineEdit, ListView, VerticalBox, HorizontalBox } from "std-widgets.slint";

export struct ItemData {
    name: string,
    tags: [string],
}

export component MainWindow inherits Window {
    title: "1kauf";
    preferred-width: 400px;
    preferred-height: 720px;

    in property <[ItemData]> items;
    in property <string> status;
    // Cleared by the dismiss button, so failures need no round trip through Rust.
    in-out property <string> error;
    in property <bool> can-undo;
    in-out property <string> server;
    in-out property <string> list-name;
    in-out property <string> token;
    in-out property <string> device;
    in-out property <bool> settings-open;
    // Which row currently shows its tag input; -1 for none.
    in-out property <int> tagging: -1;

    callback add-item(string);
    callback remove-item(string);
    callback add-tag(string, string);
    callback remove-tag(string, string);
    callback undo();
    callback sync();
    callback save-settings();

    VerticalBox {
        padding: 8px;
        // Slint draws under the system status bar, so the top inset is ours to reserve.
        padding-top: 32px;
        spacing: 8px;

        HorizontalBox {
            padding: 0px;
            spacing: 4px;
            alignment: start;
            Text {
                text: "1kauf";
                font-size: 20px;
                font-weight: 700;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Button {
                text: "undo";
                enabled: can-undo;
                clicked => {
                    undo();
                }
            }
            Button {
                text: "sync";
                clicked => {
                    sync();
                }
            }
            Button {
                text: "⚙";
                clicked => {
                    settings-open = !settings-open;
                }
            }
        }

        if settings-open: VerticalBox {
            padding: 0px;
            spacing: 4px;
            Text {
                text: "server";
                font-size: 12px;
            }
            LineEdit {
                placeholder-text: "http://127.0.0.1:8137";
                text <=> server;
                edited => {
                    save-settings();
                }
            }
            Text {
                text: "list";
                font-size: 12px;
            }
            LineEdit {
                text <=> list-name;
                edited => {
                    save-settings();
                }
            }
            Text {
                text: "token";
                font-size: 12px;
            }
            LineEdit {
                text <=> token;
                edited => {
                    save-settings();
                }
            }
            Text {
                text: "this device: " + device;
                font-size: 12px;
            }
        }

        HorizontalBox {
            padding: 0px;
            draft := LineEdit {
                placeholder-text: "add an item";
                horizontal-stretch: 1;
                accepted(text) => {
                    add-item(text);
                    self.text = "";
                }
            }
            Button {
                text: "+";
                clicked => {
                    add-item(draft.text);
                    draft.text = "";
                }
            }
        }

        ListView {
            vertical-stretch: 1;
            for item[idx] in items: Rectangle {
                height: 56px;
                HorizontalBox {
                    padding: 4px;
                    spacing: 6px;
                    Button {
                        text: "✓";
                        clicked => {
                            remove-item(item.name);
                        }
                    }
                    Text {
                        text: item.name;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    for tag in item.tags: Button {
                        text: tag + " ×";
                        clicked => {
                            remove-tag(item.name, tag);
                        }
                    }
                    if tagging == idx: LineEdit {
                        width: 90px;
                        placeholder-text: "2x";
                        // Pops the soft keyboard as soon as the field appears.
                        init => {
                            self.focus();
                        }
                        accepted(text) => {
                            add-tag(item.name, text);
                            tagging = -1;
                        }
                    }
                    if tagging != idx: Button {
                        text: "+";
                        clicked => {
                            tagging = idx;
                        }
                    }
                }
            }
        }

        Text {
            text: status;
            font-size: 12px;
        }
    }

    if error != "": Rectangle {
        width: 100%;
        height: 100%;
        background: #00000099;

        // Swallows taps so the list cannot be edited while the error is up.
        TouchArea {
            width: 100%;
            height: 100%;
        }

        Rectangle {
            width: parent.width - 32px;
            height: card.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #fdfdfd;
            border-radius: 12px;

            card := VerticalBox {
                padding: 16px;
                spacing: 12px;
                Text {
                    text: "sync failed";
                    font-size: 16px;
                    font-weight: 700;
                    color: #1c1c1a;
                }
                Text {
                    text: error;
                    font-size: 13px;
                    color: #1c1c1a;
                    wrap: word-wrap;
                }
                Button {
                    text: "ok";
                    clicked => {
                        error = "";
                    }
                }
            }
        }
    }
}
